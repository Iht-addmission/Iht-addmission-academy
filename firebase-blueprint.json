{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and enrollment status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "isPaid": { "type": "boolean" },
        "enrolledCourses": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Class": {
      "title": "Class",
      "description": "Educational class session info",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "teacher": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "durationMinutes": { "type": "number" },
        "meetLink": { "type": "string" },
        "courseId": { "type": "string" },
        "status": { "type": "string", "enum": ["upcoming", "live", "completed"] },
        "materials": { "type": "array", "items": { "type": "object", "properties": { "title": { "type": "string" }, "url": { "type": "string" } } } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "teacher", "startTime", "meetLink", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/classes/{classId}": {
      "schema": "Class",
      "description": "Class session records"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat sessions between teachers and students"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Individual messages in a chat"
    }
  },
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and enrollment status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "isPaid": { "type": "boolean" },
        "enrolledCourses": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Class": {
      "title": "Class",
      "description": "Educational class session info",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "teacher": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "durationMinutes": { "type": "number" },
        "meetLink": { "type": "string" },
        "courseId": { "type": "string" },
        "status": { "type": "string", "enum": ["upcoming", "live", "completed"] },
        "materials": { "type": "array", "items": { "type": "object", "properties": { "title": { "type": "string" }, "url": { "type": "string" } } } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "teacher", "startTime", "meetLink", "status"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Chat metadata",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "teacherId": { "type": "string" },
        "studentId": { "type": "string" },
        "teacherName": { "type": "string" },
        "studentName": { "type": "string" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "teacherId", "studentId"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single chat message",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text", "createdAt"]
    }
  }
}
