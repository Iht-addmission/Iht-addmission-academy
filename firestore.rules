rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      // In this app, we don't strictly require email verification for initial demo
      return isSignedIn();
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'xoysharif@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'admin')
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'teacher')
      );
    }

    function isPaid() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isPaid', false) == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    match /test/connection {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || 
                  isAdmin() || 
                  isTeacher() ||
                  (resource != null && 'role' in resource.data && resource.data.role == 'teacher');
      allow create: if isSignedIn() && request.auth.uid == userId && 
                    (!('role' in request.resource.data) || request.resource.data.role == 'student');
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'phoneNumber', 'bio'])) ||
        isAdmin()
      );
    }

    // Chats Collection
    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin());
        allow create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || (request.resource.data.senderId == request.auth.uid) || isAdmin());
      }
    }

    // Admissions Collection
    match /admissions/{admissionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.email == request.auth.token.email);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Classes Collection
    match /classes/{classId} {
      allow read: if isSignedIn() && (isPaid() || isAdmin());
      allow list: if isSignedIn() && (isPaid() || isAdmin());
      allow write: if isAdmin();
    }

    // Notices Collection
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    // Courses Collection
    match /courses/{courseId} {
      allow read: if true; // Public view
      allow list: if true; // Public view
      allow write: if isAdmin();
    }

    // Institutes Collection
    match /institutes/{instituteId} {
      allow read: if true; // Public view
      allow list: if true; // Public view
      allow write: if isAdmin();
    }

    // Exams Collection
    match /exams/{examId} {
      allow read: if isSignedIn() && (isPaid() || isAdmin());
      allow list: if isSignedIn() && (isPaid() || isAdmin());
      allow write: if isAdmin();
    }

    // Exam Results Collection
    match /examResults/{resultId} {
      allow read: if isSignedIn() && (resource.data.userEmail == request.auth.token.email || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userEmail == request.auth.token.email || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userEmail == request.auth.token.email || request.resource.data.userId == request.auth.uid);
    }

    // Settings Collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Study Sessions Collection (Pomodoro timer logs & consistency tracking)
    match /study_sessions/{sessionId} {
      allow read, list: if isSignedIn() && (resource.data.userEmail == request.auth.token.email || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userEmail == request.auth.token.email || isAdmin());
      allow delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
